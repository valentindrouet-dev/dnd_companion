{
  "name": "dnd-companion",
  "version": "0.10.0",
  "private": true,
  "description": "Compagnon de table pour MJ D&D 5e (2024), pensé pour iPad.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "validate": "node tools/validate.mjs",
    "test": "node tools/validate.mjs && node tools/check-pages.mjs",
    "icons": "python3 tools/make-icons.py",
    "maps": "python3 tools/make-maps.py",
    "check": "node tools/check-pages.mjs",
    "version": "node tools/set-version.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
